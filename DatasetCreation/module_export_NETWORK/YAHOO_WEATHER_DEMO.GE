(*@PROPERTIES_EX@
TYPE: POU
LOCALE: 0
IEC_LANGUAGE: FBD
PLC_TYPE: independent
PROC_TYPE: independent
GROUP: DEMO
*)
(*@KEY@:DESCRIPTION*)

CASE state OF 
00: (* auf positive Flanke SET warten *)
  IF SET AND NOT SET_LAST THEN
    state := 10;
    TP := FALSE;
	TOTAL_SIZE := 0;
	HTTP_SIZE := 0;
	HTTP_STATUS := '';
    ERROR := BYTE#0;

    (*####################  DEBUG-MESSAGE  ###################################*)
    IF LOG_CONTROL.bo_Debug THEN
      LOG_CONTROL.st_New_Message := STRING#'~S HTTP: S00 START /IP_ID ~4';
      LOG_CONTROL.sta_PRINTF[4]  := BYTE_TO_STRING(IP_ID,'%u');
      LOG_MESSAGE();
    END_IF;
    (*########################################################################*)

  END_IF;

10: (* Bei IP_Control anmelden *)
  IP_FIFO(FIFO:=IPC.FIFO,COM:=BYTE#1,IP_ID:=IP_ID);
  IPC.FIFO:=IP_FIFO.FIFO;
  IP_ID:=IP_FIFO.IP_ID;

  IF IP_FIFO.DONE THEN
    (*####################  DEBUG-MESSAGE  ###################################*)
    IF LOG_CONTROL.bo_Debug THEN
      LOG_CONTROL.st_New_Message := STRING#'~S HTTP: S10 FIFO ADD OK /IP_ID ~4';
      LOG_CONTROL.sta_PRINTF[4]  := BYTE_TO_STRING(IP_ID,'%u');
      LOG_MESSAGE();
    END_IF;
    (*########################################################################*)
    state := 20; 
  END_IF;

20: (* Warten auf freien Kanal *)
  IP_FIFO(FIFO:=IPC.FIFO,COM:=BYTE#2,IP_ID:=IP_ID);
  IPC.FIFO:=IP_FIFO.FIFO;
  IP_ID:=IP_FIFO.IP_ID;

  IF IP_FIFO.DONE THEN

    (* krücke für pcworx -> kein $0D$0A im String möglich *)
    DELIMITER := CONCAT(BYTE_TO_STRING(BYTE#16#0D,'%c'),BYTE_TO_STRING(BYTE#16#0A,'%c'));

	text := CONCAT('GET ',URL_DATA.PATH);

    IF LEN(URL_DATA.QUERY) > 0 THEN
	  text := CONCAT(text,'?');
	  text := CONCAT(text,URL_DATA.QUERY);
	END_IF;

    text := CONCAT(text,' HTTP/1.1');
    text := CONCAT(text,DELIMITER);
    text := CONCAT(text,'Host: ');
    text := CONCAT(text,URL_DATA.DOMAIN);
    text := CONCAT(text,DELIMITER);
    text := CONCAT(text,'Connection: Keep-Alive');
    text := CONCAT(text,DELIMITER);
    text := CONCAT(text,DELIMITER);

    i2 := LEN(TEXT);
    FOR i := 1 TO i2 DO
      S_BUF.DATA[i] := INT_TO_BYTE(GET_CHAR(text,i));
    END_FOR;

    state := 30;

    (* IP Datenverkehr einrichten *) 
    IPC.C_PORT   := WORD#80;     (* Portnummer eintragen                          *)
    IPC.C_IP     := IP4;         (* IP eintragen                                  *)
    IPC.C_MODE   := BYTE#0;      (* Mode: TCP/AKTIV                               *)
    IPC.C_ENABLE := TRUE;        (* Verbindungsaufbau freigeben                   *)
    S_BUF.COUNT  := i2;          (* Sendelänge eintragen                          *)
    R_BUF.COUNT  := 0;           (* Empfangslänge rücksetzen                      *) 

    (*####################  DEBUG-MESSAGE  ###################################*)
    IF LOG_CONTROL.bo_Debug THEN
      LOG_CONTROL.st_New_Message := STRING#'~S HTTP: S20 SEND /IP_ID ~4';
      LOG_CONTROL.sta_PRINTF[4]  := BYTE_TO_STRING(IP_ID,'%u');
      LOG_MESSAGE();
    END_IF;
    (*########################################################################*)

  END_IF;

30:
  IF IPC.C_TIME_ERROR OR IPC.S_TIME_ERROR OR IPC.R_TIME_ERROR AND FALSE THEN  (* Connect/Send/Receive Timeout Error *)
    ERROR := BYTE#255;           (* Timeout            *)
  END_IF;
  
  IF TOTAL_SIZE = 0 THEN
    IF R_BUF.COUNT > 15 THEN;  (* länge der empfangenen Daten prüfen *)

      search := CONCAT(DELIMITER,DELIMITER);

      (* HTTP HEADER Ende suchen -> durch $0D$A$0D$A erkennbar                              *)
      BUFFER_SEARCH_IPC(size:=INT_TO_UINT(R_BUF.COUNT),str:=search,pos:=1,ign:=BYTE#00,pt:=R_BUF.DATA);
      R_BUF.DATA:=BUFFER_SEARCH_IPC.pt;

      IF BUFFER_SEARCH_IPC.BUFFER_SEARCH > 0 THEN
        HTTP_SIZE := BUFFER_SEARCH_IPC.BUFFER_SEARCH +3;
      END_IF;

      (*####################  DEBUG-MESSAGE  ###################################*)
      IF LOG_CONTROL.bo_Debug THEN
        LOG_CONTROL.st_New_Message := STRING#'~S HTTP: S20 HEADER_SIZE ~1 /IP_ID ~4';
        LOG_CONTROL.sta_PRINTF[4]  := BYTE_TO_STRING(IP_ID,'%u');
        LOG_CONTROL.sta_PRINTF[1]  := INT_TO_STRING(HTTP_SIZE,'%d');
        LOG_MESSAGE();
      END_IF;
      (*########################################################################*)

      (* HTML Statuscode auswerten steht immer am beginn *)
      READ_HTML_LINE(size:=INT_TO_UINT(HTTP_SIZE),pos:=1,pt:=R_BUF.DATA);
      R_BUF.DATA:=READ_HTML_LINE.pt;
      i := LEN(READ_HTML_LINE.READ_HTML_LINE);
      IF i>12 THEN
        (* Code und Meldung isolieren *)
        HTTP_STATUS := RIGHT(READ_HTML_LINE.READ_HTML_LINE,i-9);      
      END_IF;

      (* positive HTTP Anfrage ? *)
      IF FIND(HTTP_STATUS,'200') > 0 THEN

        (* Versuch den Eintrag zu lesen: Content-Length  *)
        BUFFER_SEARCH_IPC(size:=INT_TO_UINT(HTTP_SIZE),str:='Content-Length: ',pos:=1,ign:=BYTE#00,pt:=R_BUF.DATA);
        R_BUF.DATA:=BUFFER_SEARCH_IPC.pt;
        i2:=BUFFER_SEARCH_IPC.BUFFER_SEARCH;

        IF i2 > 0 THEN
          (* 'Content-Length: Wert einlesen auswerten *)
          READ_HTML_LINE(size:=INT_TO_UINT(HTTP_SIZE),pos:=i2,pt:=R_BUF.DATA);
          R_BUF.DATA:=READ_HTML_LINE.pt;
          text2:=READ_HTML_LINE.READ_HTML_LINE;
          i := LEN(text2);
          IF i > 16 THEN
            text2 := RIGHT(text2,i-16);

            IS_ALNUM(str:=text2,EXT_ASCII:=FALSE);
            IF IS_ALNUM.IS_ALNUM THEN
              (* erwartete gesamtmenge an Bytes berechnen *)
              TOTAL_SIZE := STRING_TO_INT(text2)+ HTTP_SIZE;

              (*####################  DEBUG-MESSAGE  ###################################*)
              IF LOG_CONTROL.bo_Debug THEN
                LOG_CONTROL.st_New_Message := STRING#'~S HTTP: S20 TOTAL_SIZE ~1 /IP_ID ~4';
                LOG_CONTROL.sta_PRINTF[4]  := BYTE_TO_STRING(IP_ID,'%u');
                LOG_CONTROL.sta_PRINTF[1]  := INT_TO_STRING(TOTAL_SIZE,'%d');
                LOG_MESSAGE();
              END_IF;
              (*########################################################################*)
		    END_IF;
          ELSE
            ERROR := BYTE#252; (* ungültige Content-Length *) 
		  END_IF;
        ELSE
   	      ERROR := BYTE#253; (* Content-Length nicht gefunden *) 
        END_IF;
      ELSE
	    ERROR := BYTE#254; (* Fehler durch HTTP-Statuscodes *) 
      END_IF;
    END_IF;
  ELSIF TOTAL_SIZE >= R_BUF.COUNT THEN
    TP := TRUE;
  END_IF;

  
  (* Ende ? *)
  IF TP OR ERROR > BYTE#0 THEN
    IPC.C_ENABLE := FALSE;   (* Verbindungsaufbau sperren           *)
    state := 40;
  END_IF;

  IF TP THEN  
    (*####################  DEBUG-MESSAGE  ###################################*)
    IF LOG_CONTROL.bo_Debug THEN
      LOG_CONTROL.st_New_Message := STRING#'~S HTTP: S30 OK /IP_ID ~4';
      LOG_CONTROL.sta_PRINTF[4]  := BYTE_TO_STRING(IP_ID,'%u');
      LOG_MESSAGE();
    END_IF;
    (*########################################################################*)
  END_IF;

  (*####################  DEBUG-MESSAGE  ###################################*)
  IF ERROR > BYTE#0 THEN
    IF LOG_CONTROL.bo_Debug THEN
      LOG_CONTROL.st_New_Message := STRING#'~S HTTP: S30 ERROR C~1/S~2/R~3 /IP_ID ~4';
      LOG_CONTROL.sta_PRINTF[1]  := INT_TO_STRING(BOOL_TO_INT(IPC.C_TIME_ERROR),'%d');
      LOG_CONTROL.sta_PRINTF[2]  := INT_TO_STRING(BOOL_TO_INT(IPC.S_TIME_ERROR),'%d');
      LOG_CONTROL.sta_PRINTF[3]  := INT_TO_STRING(BOOL_TO_INT(IPC.R_TIME_ERROR),'%d');
      LOG_CONTROL.sta_PRINTF[4]  := BYTE_TO_STRING(IP_ID,'%u');
      LOG_MESSAGE();
    END_IF;
  END_IF;
  (*########################################################################*)

40: (* Verbindung beendet -> IP_ID vom Stack nehmen *)
  IF NOT IPC.C_READY THEN
    state := 00;
    IP_FIFO(FIFO:=IPC.FIFO,COM:=BYTE#3,IP_ID:=IP_ID);
    IPC.FIFO:=IP_FIFO.FIFO;
    IP_ID:=IP_FIFO.IP_ID;
  END_IF;
END_CASE;

SET_LAST := SET; (* letzten Status sichern zur Flankenerkennung *)
(*@KEY@:END_DESCRIPTION*)
PROGRAM YAHOO_WEATHER_DEMO

